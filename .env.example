# Two separate, valid keys for the chosen LiteLLM provider. NEVER commit real credentials.
LLM_API_KEYS=YOUR_FIRST_GEMINI_KEY,YOUR_SECOND_GEMINI_KEY
# Supports a LiteLLM model name. Change only if your provider requires it.
LLM_MODEL=gemini/gemini-2.5-flash
DATABASE_URL=sqlite:////data/app.db
# Add your Vercel URL here after frontend deployment (comma-separated, NO trailing slashes).
ALLOWED_ORIGINS=http://localhost:3000,https://YOUR-PROJECT.vercel.app
ENABLE_FAILURE_SIMULATION=true
LLM_TIMEOUT_SECONDS=45
DEFAULT_SYSTEM_PROMPT=You are Relay, a thoughtful, precise and helpful AI assistant. Give clear and accurate answers.
